#VibeCraft limbo backend (rendered from proxy/config/limbo-server.properties.tmpl on every start)
server-ip=127.0.0.1
server-port={{LIMBO_PORT}}
online-mode=false
enforce-secure-profile=false
white-list=false
enforce-whitelist=false
max-players=500
motd=VibeCraft limbo
enable-rcon=true
rcon.port={{LIMBO_RCON_PORT}}
rcon.password={{LIMBO_RCON_PASSWORD}}
broadcast-rcon-to-ops=false
broadcast-console-to-ops=false
enable-status=true
level-name=limbo
level-type=minecraft\:flat
generator-settings={"layers"\:[{"block"\:"minecraft\:barrier","height"\:1},{"block"\:"minecraft\:light_blue_stained_glass","height"\:1}],"biome"\:"minecraft\:the_void","features"\:false,"lakes"\:false}
generate-structures=false
view-distance=2
simulation-distance=2
difficulty=peaceful
gamemode=adventure
force-gamemode=true
spawn-protection=0
allow-flight=true
pvp=false
hardcore=false
network-compression-threshold=-1
sync-chunk-writes=false
max-tick-time=-1
player-idle-timeout=0
pause-when-empty-seconds=30
entity-broadcast-range-percentage=50
log-ips=false
enable-query=false
enable-jmx-monitoring=false
management-server-enabled=false
